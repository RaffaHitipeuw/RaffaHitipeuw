        { "key": "Repos", "value": "{{repos}}" },
        { "key": "Stars", "value": "{{stars}}" },
        { "key": "Commits", "value": "{{commits}}" },
        { "key": "Lines of Code", "value": "{{linesOfCode}}" }
      ]
    }
  ]
}
